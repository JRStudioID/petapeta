# Port server Node.js (default: 3000)
PORT=3000

# Environment mode
NODE_ENV=production

# Kunci rahasia untuk enkripsi JWT session cookie (Ganti dengan string acak minimal 32 karakter)
JWT_SECRET=petakaya-secret-key-production-change-this-32-chars

# Koneksi Database MySQL Hostinger (Opsional jika menggunakan database MySQL hPanel)
# Format: mysql://<username>:<password>@localhost:3306/<database_name>
DATABASE_URL=

# Integrasi OAuth (Opsional)
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
